{
  "name": "@circlesac/vlt-cli",
  "description": "1Password-style secrets CLI for Circles Vault",
  "type": "module",
  "bin": {
    "cvlt": "bin/cvlt.mjs"
  },
  "exports": {
    "./connect": {
      "types": "./dist/connect.d.ts",
      "import": "./dist/connect.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "bun build --compile src/index.ts --outfile cvlt",
    "build:connect": "tsc -p tsconfig.connect.json",
    "dev": "bun run src/index.ts",
    "test": "bun test src/",
    "postinstall": "node bin/install.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/circlesac/cvlt-cli.git"
  },
  "dependencies": {
    "@circlesac/credentials": "^1.1.0",
    "citty": "^0.2.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
